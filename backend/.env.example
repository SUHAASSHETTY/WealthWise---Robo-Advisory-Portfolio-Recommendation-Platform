# WealthWise backend settings (pydantic-settings, prefix WEALTHWISE_). Copy to backend/.env for local overrides.

# SQLAlchemy URL. SQLite file in backend/ by default.
WEALTHWISE_DATABASE_URL=sqlite:///./wealthwise.db

# Root log level for the JSON logger (DEBUG, INFO, WARNING, ERROR).
WEALTHWISE_LOG_LEVEL=INFO

# Accept the synthetic stub bearer tokens (stub-token-alice, …). Defaults to false; enable ONLY for local dev/tests.
WEALTHWISE_STUB_AUTH_ENABLED=true
